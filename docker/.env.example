# =============================================================================
# VNALO Ã¢â‚¬â€ Docker Environment Variables
# Copy this file to .env in the same directory as docker-compose.yml
# Usage: cp .env.example .env && edit .env
# =============================================================================

# --- Database (PostgreSQL) ---
DB_NAME=vnalo_core
# content-service: dùng vnalo_core (schema content + bảng friendship)
CONTENT_DB_NAME=vnalo_core
DB_USER=postgres
DB_PASS=postgres
DB_PORT=5432

# --- Redis ---
REDIS_PORT=6379
# REDIS_PASSWORD=         # Uncomment and set for production

# --- JWT (REQUIRED Ã¢â‚¬â€ must match between core-service and message-service) ---
JWT_SECRET=your-jwt-secret-here-at-least-512-bits-long-for-hs512
JWT_ISSUER=vnalo

# --- Core Service (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
# Comma-separated emails allowed to access /api/v1/admin/monitoring/**
ADMIN_MONITORING_ALLOWED_EMAILS=admin@vnalo.fit
# --- Firebase Push Notifications (core-service + notification-service) ---
# Set to true in production; in dev you can leave false to skip Firebase init
FIREBASE_ENABLED=true
FIREBASE_FAIL_FAST=true
# Directory on HOST containing firebase-adminsdk.json (mounted to /app/firebase-credentials in containers)
# Create this directory and place your firebase-adminsdk.json file there:
#   mkdir firebase-credentials
#   cp /path/to/your/firebase-adminsdk.json firebase-credentials/
FIREBASE_CREDENTIALS_DIR=${FIREBASE_CREDENTIALS_DIR:-./firebase-credentials}

# --- OTP Email (Core Service) ---
OTP_ENABLED=true
OTP_EMAIL_ENABLED=true
OTP_TEST_MODE=false
OTP_LOG_OTP=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
MAIL_APP_PASSWORD=your-gmail-app-password
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000

# --- Message Service (NestJS) ---
NODE_ENV=development

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Media Service (Spring Boot + AWS S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=vnalo-media
AWS_REGION=ap-southeast-1
AWS_S3_ENDPOINT=
# AWS_S3_PUBLIC_ENDPOINT=https://vnalo-media-service.s3.amazonaws.com

# --- Logging ---
LOG_LEVEL=INFO

# --- AI Service (Spring Boot) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
AI_RATE_LIMIT=5
AI_RATE_LIMIT_GLOBAL=10


# Force web password login to require known device / QR approval from trusted mobile
APP_SYNC_POLICY_ENFORCE_WEB_RESTRICTION=false

# Optional one-time bootstrap emails to grant SUPER_ADMIN on startup (RBAC remains DB-backed)
ADMIN_MONITORING_BOOTSTRAP_EMAILS=
