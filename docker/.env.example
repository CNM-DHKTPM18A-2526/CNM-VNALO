# =============================================================================
# VNALO — Docker Environment Variables
# Copy this file to .env in the same directory as docker-compose.yml
# Usage: cp .env.example .env && edit .env
# =============================================================================

# --- Database (PostgreSQL) ---
DB_NAME=vnalo_core
DB_USER=postgres
DB_PASS=postgres
DB_PORT=5432

# --- Redis ---
REDIS_PORT=6379
# REDIS_PASSWORD=         # Uncomment and set for production

# --- JWT (REQUIRED — must match between core-service and message-service) ---
JWT_SECRET=your-jwt-secret-here-at-least-512-bits-long-for-hs512
JWT_ISSUER=vnalo

# --- Core Service (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
# FIREBASE_CREDENTIALS_PATH=path/to/firebase-adminsdk.json  # Mount or bake into image

# --- Message Service (NestJS) ---
NODE_ENV=development

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Media Service (Spring Boot + AWS S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=vnalo-media
AWS_REGION=ap-southeast-1

# --- Logging ---
LOG_LEVEL=INFO

# --- AI Service (Spring Boot) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
AI_RATE_LIMIT=5
AI_RATE_LIMIT_GLOBAL=10

