# =============================================================================
# VNALO — Docker Environment Variables
# Copy this file to .env in the same directory as docker-compose.yml
# Usage: cp .env.example .env && edit .env
# =============================================================================

# --- Database (PostgreSQL) ---
DB_NAME=vnalo_core
DB_USER=postgres
DB_PASS=postgres
DB_PORT=5432

# --- Redis ---
REDIS_PORT=6379
# REDIS_PASSWORD=         # Uncomment and set for production

# --- JWT (REQUIRED — must match between core-service and message-service) ---
JWT_SECRET=your-jwt-secret-here-at-least-512-bits-long-for-hs512
JWT_ISSUER=vnalo

# --- Core Service (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
# FIREBASE_CREDENTIALS_PATH=path/to/firebase-adminsdk.json  # Mount or bake into image

# --- Message Service (NestJS) ---
NODE_ENV=development

# --- Logging ---
LOG_LEVEL=INFO
