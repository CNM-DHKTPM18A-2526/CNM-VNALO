  "item": [
    {
      "name": "Health - Analytics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{analyticsBaseUrl}}/actuator/health",
          "host": ["{{analyticsBaseUrl}}"],
          "path": ["actuator", "health"]
        }
      }
    },
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"{{testPhone}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"{{displayName}}\"\n}"
        },
        "url": {
          "raw": "{{coreBaseUrl}}/auth/register",
          "host": ["{{coreBaseUrl}}"],
          "path": ["auth", "register"]
        }
      }
    },
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login success', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "const token = json?.data?.accessToken;",
              "pm.environment.set('accessToken', token || '');",
              "if (token) {",
              "  const payload = JSON.parse(atob(token.split('.')[1]));",
              "  pm.environment.set('userId', payload.sub || '');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{testPhone}}\",\n  \"password\": \"{{password}}\",\n  \"deviceId\": \"postman-device\",\n  \"deviceName\": \"Postman\"\n}"
        },
        "url": {
          "raw": "{{coreBaseUrl}}/auth/login",
          "host": ["{{coreBaseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "Bootstrap - Bootstrap Quyen ADMIN (PowerShell)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Ghi chu: Chay lenh SQL tay o PowerShell de seed moderation_admin_user",
              "// Chi tiet xem trong Test Tab va analytics-api-test-guide.md"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{analyticsBaseUrl}}/actuator/health",
          "host": ["{{analyticsBaseUrl}}"],
          "path": ["actuator", "health"]
        }
