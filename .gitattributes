# Ensure shell scripts always use LF (Unix line endings) even on Windows
*.sh text eol=lf
mvnw text eol=lf

# Ensure text files normalize to LF
*.java text eol=lf
*.kt text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.dart text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.env text eol=lf
Dockerfile text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf

# Binary files - don't touch
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
*.tar.gz binary
