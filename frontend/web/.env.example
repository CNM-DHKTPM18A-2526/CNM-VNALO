# ──────────────────────────────────────────────────────────────────────────────
# VNALO Web Environment Variables
#
# For LOCAL development: use the localhost defaults.
# For PRODUCTION (EC2): set all URLs to http://13.250.2.132/api/v1
#                       (all services are routed through the Nginx gateway)
# ──────────────────────────────────────────────────────────────────────────────

# Core API – Auth, User Management, Friends
VITE_CORE_API_URL=http://13.250.2.132/api/v1

# Message API – Chat, Conversations (via Nginx /api/v1/)
VITE_MESSAGE_API_URL=http://13.250.2.132/api/v1

# Media/AI/Analytics API (via Nginx /api/v1/)
VITE_MEDIA_API_URL=http://13.250.2.132/api/v1

# Socket.io WebSocket
# Connects through Nginx; falls back to stripping /api/v1 from VITE_MESSAGE_API_URL
# Uncomment and set if you need an explicit Socket URL:
# VITE_SOCKET_URL=http://13.250.2.132

# WebRTC TURN Server (Highly Recommended for 4G/LTE stability)
VITE_TURN_URL=turn:openrelay.metered.ca:80
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_PASSWORD=openrelayproject
