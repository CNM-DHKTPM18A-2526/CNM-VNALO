# ──────────────────────────────────────────────────────────────────────────────
# VNALO Web Environment Variables
#
# For LOCAL development: use http://localhost:8081/api/v1
# For PRODUCTION (vnalo.fit): use https://vnalo.fit/api/v1
# ──────────────────────────────────────────────────────────────────────────────

# Main API – Auth, User Management, Friends
VITE_API_BASE_URL=https://vnalo.fit/api/v1

# Message API – Chat, Conversations (via Nginx /api/v1/)
VITE_MESSAGE_API_URL=https://vnalo.fit/api/v1

# Media API (via Nginx /api/v1/media)
VITE_MEDIA_API_URL=https://vnalo.fit/api/v1/media

# Socket.io WebSocket (WSS for production)
VITE_WS_BASE_URL=wss://vnalo.fit

# WebRTC TURN Server (Highly Recommended for 4G/LTE stability)
VITE_TURN_URL=turn:openrelay.metered.ca:80
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_PASSWORD=openrelayproject
