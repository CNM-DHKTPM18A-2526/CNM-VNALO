# =============================================================================
# VNALO — Global Environment Variables Example
# Copy to .env and fill in actual values
# =============================================================================

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vnalo_core
DB_USER=postgres
DB_PASS=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=         # Set for production

# JWT (MUST be identical for core-service and message-service)
JWT_SECRET=your-very-long-secret-key-at-least-512-bits-for-hs512-algorithm
JWT_ISSUER=vnalo
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Firebase (push notifications — both services share the same credentials file)
# Set FIREBASE_CREDENTIALS_DIR to the directory containing firebase-adminsdk.json
# Example: ./firebase-credentials/firebase-adminsdk.json
FIREBASE_ENABLED=true
FIREBASE_FAIL_FAST=true

# OTP + SMTP (core-service email OTP)
OTP_ENABLED=true
OTP_EMAIL_ENABLED=true
OTP_EMAIL_FROM_NAME=VNALO Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
MAIL_APP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000

# Mobile dev note:
# Flutter mobile does not load this file automatically.
# For emulator/device endpoint overrides, pass --dart-define values instead:
# flutter run --dart-define=ENV=dev --dart-define=CORE_SERVICE_URL=http://192.168.1.88:8081/api/v1

# Core Service (Spring Boot)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# Message Service (NestJS)
PORT=3000
NODE_ENV=development

# Media Service (Spring Boot)
MEDIA_SERVICE_PORT=8083
MEDIA_SERVICE_URL=http://localhost:8083/api/v1/media

# AWS S3 (media-service)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=vnalo-media
AWS_REGION=ap-southeast-1
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_ENDPOINT=https://vnalo-media.s3.amazonaws.com

# Frontend / API Gateway (HTTPS Production)
# These are used by both backend services and web build process
VITE_API_BASE_URL=https://vnalo.fit/api/v1
VITE_MESSAGE_API_URL=https://vnalo.fit/api/v1
VITE_MEDIA_API_URL=https://vnalo.fit/api/v1/media
VITE_WS_BASE_URL=wss://vnalo.fit

# Logging
LOG_LEVEL=INFO

# AI Internal Secret (Service-to-service communication)
AI_INTERNAL_SECRET=your-secure-internal-secret-for-service-to-service-calls

