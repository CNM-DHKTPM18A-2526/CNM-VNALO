# =============================================================================
# VNALO — Global Environment Variables Example
# Copy to .env and fill in actual values
# =============================================================================

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vnalo_core
DB_USER=postgres
DB_PASS=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=         # Set for production

# JWT (MUST be identical for core-service and message-service)
JWT_SECRET=your-very-long-secret-key-at-least-512-bits-for-hs512-algorithm
JWT_ISSUER=vnalo
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Firebase (core-service — push notifications)
FIREBASE_CREDENTIALS_PATH=path/to/firebase-adminsdk.json

# OTP + SMTP (core-service email OTP)
OTP_ENABLED=true
OTP_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
MAIL_APP_PASSWORD=

# Core Service (Spring Boot)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# Message Service (NestJS)
PORT=3000
NODE_ENV=development

# Media Service (Spring Boot)
MEDIA_SERVICE_PORT=8083
MEDIA_SERVICE_URL=http://localhost:8083/api/v1

# AWS S3 (media-service)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=vnalo-media
AWS_REGION=ap-southeast-1
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_ENDPOINT=https://vnalo-media.s3.amazonaws.com

# Logging
LOG_LEVEL=INFO
