# ============================================================
# Message Service Environment Variables
# Copy to .env and fill in values
# ============================================================

# Server
PORT=3000

# Database (same PostgreSQL as core-service)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vnalo_core
DB_USER=postgres
DB_PASS=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (MUST match core-service JWT_SECRET!)
JWT_SECRET=your-jwt-secret-here
JWT_ISSUER=vnalo

# Kafka (for notification events)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=vnalo-message-service
KAFKA_NOTIFICATIONS_TOPIC=vnalo.notifications

# Environment
NODE_ENV=development

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://10.0.2.2:3000
