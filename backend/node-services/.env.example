# ============================================================
# Message Service Environment Variables
# Copy to .env and fill in values
# ============================================================

# Server
PORT=3000

# Database (same PostgreSQL as core-service)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vnalo_core
DB_USER=postgres
DB_PASS=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (MUST match core-service JWT_SECRET!)
JWT_SECRET=your-jwt-secret-here
JWT_ISSUER=vnalo

# Environment
NODE_ENV=development
